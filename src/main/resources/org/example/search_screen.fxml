<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.gui.controllers.SearchController">
    <children>
        <Label layoutX="187.0" layoutY="21.0" text="Search Book Availability">
            <font>
                <Font name="Arial" size="21.0" />
            </font>
        </Label>
        <Label layoutX="212.0" layoutY="62.0" text="Enter title (use * for wildcard):" />
        <TextField fx:id="searchField" layoutX="190.0" layoutY="80.0" prefWidth="220.0" />
        <Button fx:id="searchBtn" layoutX="167.0" layoutY="120.0" onAction="#onSearchBtnClick" text="Search" />
        <Button fx:id="exportBtn" layoutX="345.0" layoutY="120.0" onAction="#onExportBtnClick" text="Export Results" />
        <Label fx:id="status" layoutX="50.0" layoutY="162.0" text="Results: " />
        <TextArea fx:id="resultArea" layoutX="50.0" layoutY="180.0" prefHeight="120.0" prefWidth="500.0" />
        <Button fx:id="backBtn" layoutX="170.0" layoutY="320.0" onAction="#onBackBtnClick" text="Back" />
        <Button fx:id="exitBtn" layoutX="373.0" layoutY="320.0" onAction="#onExitBtnClick" text="Exit" />
    </children>
</AnchorPane>
