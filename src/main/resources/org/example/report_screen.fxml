<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.gui.controllers.ReportController">
    <children>
        <Label layoutX="204.0" layoutY="25.0" text="Books Issued Report">
            <font>
                <Font name="Arial" size="21.0" />
            </font>
        </Label>
        <Label layoutX="232.0" layoutY="62.0" text="Enter date (dd/MM/yyyy):" />
        <TextField fx:id="dateField" layoutX="200.0" layoutY="80.0" prefWidth="200.0" />
        <Button fx:id="generateBtn" layoutX="250.0" layoutY="120.0" onAction="#onGenerateBtnClick" text="Generate Report" />
        <Label fx:id="status" layoutX="50.0" layoutY="162.0" text="Records found: " />
        <TextArea fx:id="resultArea" layoutX="50.0" layoutY="180.0" prefHeight="120.0" prefWidth="500.0" />
        <Button fx:id="backBtn" layoutX="200.0" layoutY="320.0" onAction="#onBackBtnClick" text="Back" />
        <Button fx:id="exitBtn" layoutX="368.0" layoutY="320.0" onAction="#onExitBtnClick" text="Exit" />
    </children>
</AnchorPane>
