<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.gui.controllers.MainMenuController">
    <children>
        <Label layoutX="79.0" layoutY="67.0" prefHeight="26.0" prefWidth="445.0" text="Welcome to the Library Management System!">
            <font>
                <Font name="Arial" size="21.0" />
            </font>
        </Label>
        <Label layoutX="192.0" layoutY="108.0" text="Please choose what you want to do next:">
            <font>
                <Font name="Arial" size="12.0" />
            </font>
        </Label>
        <Button fx:id="searchBtn" layoutX="219.0" layoutY="286.0" mnemonicParsing="false" onAction="#onSearchBtnClick" text="View Book Availability" />
        <Button fx:id="avgBtn" layoutX="216.0" layoutY="242.0" mnemonicParsing="false" onAction="#onAvgBtnClick" text="Calculate Average Cost" />
        <Button fx:id="reportBtn" layoutX="199.0" layoutY="200.0" mnemonicParsing="false" onAction="#onReportBtnClick" text="View the Books Issued Report" />
        <Button fx:id="importBtn" layoutX="247.0" layoutY="154.0" mnemonicParsing="false" onAction="#onImportBtnClick" text="Import files" />
        <Button fx:id="exitBtn" layoutX="267.0" layoutY="335.0" mnemonicParsing="false" onAction="#onExitBtnClick" text="Exit" />
    </children>
</AnchorPane>
