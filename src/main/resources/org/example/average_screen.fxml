<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.gui.controllers.AverageController">
    <children>
        <Label layoutX="150.0" layoutY="61.0" text="Calculating Average Cost of a Book">
            <font>
                <Font name="Arial" size="19.0" />
            </font>
        </Label>
        <Button fx:id="calculateBtn" layoutX="268.0" layoutY="104.0" mnemonicParsing="false" onAction="#onCalculateBtnClick" text="Calculate" />
        <TextArea fx:id="calculateTextArea" layoutX="81.0" layoutY="143.0" prefHeight="114.0" prefWidth="438.0" />
        <Button fx:id="backBtn" layoutX="215.0" layoutY="304.0" onAction="#handleBack" text="Back" />
        <Button fx:id="exitBtn" layoutX="356.0" layoutY="304.0" onAction="#onExitBtnClick" text="Exit" />
        <Label fx:id="resultLabel" layoutX="81.0" layoutY="266.0" text="Average Price: " />
    </children>
</AnchorPane>
